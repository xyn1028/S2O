{
    "name": "S2_withoutffttest5",
    "phase": "train", // train or val
    "gpu_ids": [0],//修改"gpu_ids": [0，1],
    "stage": 2,   // 1 for modality transform   2 for local refinement
    "ddim_steps": 1, // ddim steps for sample
    "loss_w":
        {
            "fft_w":10,
            "lpips_w": 5,
            "lambda_gan": 0.5  //530000从0.5降至0.3 230000
//            "perceptual_w": 1.0
        },

    "path": { //set the path
        "log": "logs",
        
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        // "resume_state": null
        "resume_state": "experiments/S2_withoutfft/checkpoint/I300000_E580" //pretrain model or training state
    },
    "datasets": {
        "train": {
            "name": "SEN12",
            "mode": "translate", // whether need LR img
            "dataroot": "../dataset/SEN12/train",
            "datatype": "img", //lmdb or img, path of img files
            "l_resolution": 256, // low resolution need to super_resolution
            "r_resolution": 256, // high resolution
            "batch_size": 11,
            "num_workers": 4,
            "use_shuffle": true,
            "data_len": -1 // -1 represents all data used in train
        },
        "val": {
            "name": "SEN12",
            "mode": "translate",
            "dataroot": "../dataset/SEN12/val",
            "datatype": "img", //lmdb or img, path of img files
            "l_resolution": 256,
            "r_resolution": 256,
            "data_len": 30
        }
    },
    "model": {
        "which_model_G": "sr3", // use the ddpm or sr3 network structure
        "finetune_norm": false,
        "unet": {
            "in_channel": 3,   
            // "condition_channel": 2,
            "out_channel": 3,
            "condition_ch": 3,
            "inner_channel": 64,
            "norm_groups": 16,   //GroupNorm参数
            "channel_multiplier": [
                1,
                2,
                4,
                8,
                // 8,
                // 16,
                16
            ],
            "attn_res": [
                // 16
            ],
            "res_blocks": 1,
            "dropout": 0
        },
        "beta_schedule": { // use munual beta_schedule for acceleration

            "train": {
                "schedule": "linear",   //linear
                "n_timestep": 1000,
                "linear_start": 1e-6,
                "linear_end": 1e-2,
                "ddim": 0,  //1 for ddim, 0 for ddpm
                "lq_noiselevel": 0   //0 by default

            },
            "val": {
                "schedule": "linear",  //linear
                "n_timestep": 1,  // ddim steps for sample
                "linear_start": 1e-6,
                "linear_end": 1e-2,
                "ddim": 1,  //1 for ddim, 0 for ddpm
                "lq_noiselevel": 0   //0 by default
            }
        },
        "diffusion": {
            "image_size": 256,
            "channels": 3, //sample channel
            "conditional": true // unconditional generation or unconditional generation(super_resolution)
        }
    },
    "train": {
        "n_iter": 300000,
        "val_freq": 5000,   //20000
        "save_checkpoint_freq": 10000,
        "print_freq": 100,
        "optimizer": {
            "type": "adam",
            "lr": 3e-5
        },
        "ema_scheduler": { // not used now
            "step_start_ema": 5000,
            "update_ema_every": 1,
            "ema_decay": 0.9999
        },

      "scheduler": {
            "type": "CosineAnnealingRestartLR",
            "periods": [100000, 200000],
            "restart_weights": [1, 0.5],
            "eta_min": 1e-6
        }
//    "scheduler": {
//        "type": "MultiStepLR",
//        "milestones": [250000],   // 540000
//        "gamma": 0.5
//    }
            
    },
    "wandb": {
        "project": "SEN12_S2"
    }
}